export struct LinkedList<T> {
    first_node?: LinkedListNode<T>
}

export struct LinkedListNode<T> {
    value: T,
    next?: LinkedList<T>
}

export fn LinkedList<T>::new() {
    return LinkedList<T> {
        first_node: null
    }
}

