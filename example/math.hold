export fn generic_fn<T> (arg: T): String where T is Trait1, Trait2 {

}

export struct Vec2 : Eq<Vec2> {
    x: f32,
    y: f32
}

export fn Vec2::new(x: f32, y: f32): Vec2 {
    return Vec2 {
        x: x,
        y: y
    };
}

export fn Vec2 as Eq<Vec2>::eq(self, other: Vec2): i32 {
    return absf(self.x - other.x) <= 0.0001 && absf(self.y - other.y) <= 0.0001;
}

export Trait Eq<T> {
    fn eq(self, other: T): i32;
    fn not_eq(self, other: T): i32;
}
